start class

    final path of dataFile and directory

    constructor GenshinRecordFetcher(dataFile, directory)
        this.dataFile = dataFile
        this.directory = directory
    end constructor

    final ObjectMapper = new ObjectMapper()

    start method filePath() throws Exception
        final PathValidator object pv
        create a queue<Path> = pv.getPath()

        if queue is empty or queue is null:
            throw new exception

        return pv.peek()
    end method

    start method getListBody() throws Exception
        create a new stack<JsonNode>

        JsonNode node = ObjectMapper.readTree(read file)
        JsonNode body = node.get(list)

        if body is missing or null:
            body = node.get(record)

        JsonNode info = node.get(info)
        stack add info and body

        return stack
    end method

    start fetchAllData() throw Exception

        create a new map: (UID -> GenshinPlayerData)

        get local data map: (UID -> GenshinPlayerData)

        get JsonNode:
        a new stack = getListBody()

        List<GachaRecord> list = ObjectMapper.readValue(tree as token,
                new type reference)
        InfoRecord info = ObjectMapper.treeToValue(info node, template class)

        validateBodyList()
        validateUID()
        sort bodyList in ascending time order

        list = mergeData(UID, list, local data)

        map.put(info.getUID(), new GenshinPlayerData(info, list))
        return map

    end method

    start method mergeData(newUID, list, local data)
        if MergeHelper.isDuplicate(newUID, UID list) == false:
            return list

        List<GachaRecord> localData = MergeHelper.getOldData(local data, UID)

        List<GachaRecord> mergedData = MergeHelper.mergeData(list, localData)

        sort mergeData in ascending time order
        return mergedData

    end method

    start method validateUID(InfoRecord rd)
        if rd.getUID() is null or blank:
            throw new exception
    end method

    start method validateBodyList(data list)
        if list is null or empty:
            throw new exception

        List<String> invalidList = list.stream().filter(this -> isRecordComplete).toList()

        if invalidList is not empty
            throw new exception
    end method

    start method isRecordComplete(gachaRecord record)
        set of integer: 3, 4, 5

        return isBlankOrNull(element) or
            record.getRank() does not contain the set
    end method

    start method isBlankOrNull(element)
        return element is null or empty
    end method
END


