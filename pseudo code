START
start pathValidator record class
parameter: path

    start method getPathQueue()
        create a new queue<path>

        if isValid(this.path) == false:
            throw new exception

        if isJson(this.path) == false:
            throw new exception

        queue.add(path)
        return queue
    end method

    start method isValid(path)
        return file.isReadable() and file.exist()
    end method

    start method isJson(path)
        get file content type from the path

        if the content type is null:
            return path.toString().endsWith(JSON)
        if the content is blank:
            throw new exception
        return content type.equalIgnoreCase("application/JSON")
    end method
END


