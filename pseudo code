START
start class

    create a static immutable string of fallback image path

    create two static immutable maps for storing the item's path
    Map<String, String> -> UID, Path

    create a static immutable map for storing cache path
    create and set a static boolean initialized = false

    start method initializeMaps(iconMap, dataMap, folderName)
        for(every entry of the dataMap: dataMap.entrySet())
            string id = entry.getKey()

            string processedName = processFilename(entry.getValue().get(en))

            string resourcePath = package path + folderName + processedName
            if class.getResource(resourcePath) is not null:
                iconMap add: id -> resourcePath
    end method

    start method processFilename(name)
        if name is null, return ""

        return name.toLowercase().replaceAll("[^a-z0-9]", "")
    end method

    start synchronized method ensureInitialized()
        if initialized == true, return

        try this:
            create two map for item translation
            Map<String, Map<String, String>> translationMap

            initializeMaps(iconMap, translationMap)
        catch (throwable cause):
            system print error: cause
        finally:
            set initialized == true
    end method

    start method getIcon(id)
        ensureInitialized() called out

        if cache contains id:
            return cache.get(id)

        set string path = fallback path
        if translationMap contains id:
            path = translationMap.get(id)

        initialize new url
        try this:
            url = class.getResource(path)
            if url is not null:
                create an Image with this url
                cache.put(id, image)
        catch exception:
            system prints error

        URL fallback = class.getResource(fallback path)
        if fallback is not null, return fallback image

        return createMissingImage()
    end method

    static method getIconPath(id)
        ensureInitialized()
        if translationMap contains id:
            return translationMap.contains(id)
        return fallback path
    end method

    static method createMissingImage()
         create 40*40 with bufferedImage

         new graphics2d()
         set color and draw the line
         return image
    end method
end class
