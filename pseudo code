START
start merge helper class

    start static method isDuplicate(uid, uids)
        for each x in uids
            if x equals uid
                return true
            end if
        end for

        return false
    end method

    start static getOldData(uid, map)
        player = map[uid]
        if player is null
            return empty list
        end if
        return player.records
    end method

    start static merge data(new data, local data)
        if new data empty and local data empty
            return empty list
        end if

        if local data empty:
            merge list = copy new data
        else if new data empty:
            merge list = copy local data
        else:
            latest new = get latest(new data, true)
            latest old = get latest(local data, true)
            oldest new = get latest(new data, false)
            oldest old = get latest(local data, false)

            if latest new < latest old and oldest old < oldest new:
                merge list = local data
            else:
                create map
                for each item in local data
                    map[item.id] = item
                end for
                for each item in new data
                    map[item.id] = item
                end for

                merge list = map values
            end if
        end if

        merge list = validate(merge list)
        insertion sort(merge list)
        return merge list
    end method

    start static method get latest(data, is latest)
        if is latest:
            return max time in data
        else:
            return min time in data
    end method

    start static parse time(time)
        try
            return parsed datetime
        catch error
            return minimum datetime
        end try
    end method

    start static shouldMoveAfter(left, right)
        l = parse time(left.time)
        r = parse time(right.time)

        if l > r return true
        if l < r return false

        return compareID(left.id, right.id) > 0
    end method

    start static validate(list)
        valid list = empty list

        for each item in list
            if is valid time(item.time)
                add item to valid list

        return valid list
    end method

    start static is valid time(time)
        if not match pattern
            return false

        try:
            parse and return the time
        catch error
            return false
    end method
END

























