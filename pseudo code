Start class

    final instance of GameService

    constructor Statistics(gameService)
        this.GameService = gameService
    end constructor

    start method compute() throws Exception
        declare a new map: (UID -> records)
        GenshinPlayerData = map.values().iterator().getValue()

        return generateSummary(player data)
    end method

    start static method generateSummary(player data)
        List<GachaRecord> = data.getRecord()

        string uid = data.getUID()

        declare variables for general info:
        int totalWishes, total primogem, total five-star, etc.

        // for banner 301, 400, 302, and 500:
        List<Integer> pity = calculatePity(data, banner code)
        double probability = calculateProbability(data, banner code)

        total five star number = pity.size()
        total pity = sum of integer in List<Integer>
        double overallPity = total pity / total five star number

        double overallProbability = weighting calculation

        return new GenshinStatSummary(overallPity, overallProbability, etc)
    end method

    start static method countFiveStar(records)
        for each record in records:
            if rank == 5, counter++

        return counter
    end method

    start static method countLimitedFiveStar(records)
        for each record in records:
            if rank == 5 and is character and not belongs to standard item:
                counter ++

        return counter
    end method

    start static method countFiveStarCharacter(records)
        for each record in records
            if item is character:
                counter++

        return counter
    end method

    start static method calculatePity(records, banner...)
        for each record in records
            if the item's banner != banner: continue

            counter++
            if rank == 5:
                list.add(counter)
                counter = 0

        return list
    end method

    start static method calculateProbability(records, banner)
        case -> banner type:
            get Standard banner list
            default: throws exception

        total = 0
        win = 0
        for each record in records:
            if rank == 5 and belongs to this banner:
                total++
                if item does not in standard set:
                    win++

        if total == 0, return 0

        return win/total * 100
    end method
END


